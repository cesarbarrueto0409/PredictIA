# URL base del backend REST (sin barra final). En desarrollo se usa el proxy de Vite.
VITE_API_URL=/api/v1

# true  -> datos simulados locales (no requiere backend)
# false -> consume la API real en VITE_API_URL
VITE_USE_MOCKS=true

# Solo para desarrollo: destino del proxy /api de Vite
VITE_PROXY_TARGET=http://127.0.0.1:8000
